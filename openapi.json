{
  "openapi": "3.0.3",
  "info": {
    "title": "ElimuNova AI API",
    "version": "1.0.0",
    "description": "API documentation for ElimuNova AI Education Platform",
    "contact": {
      "name": "ElimuNova AI Team",
      "email": "info@infinititechsolutions.org",
      "url": "https://infinititechsolutions.org"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Development server"
    },
    {
      "url": "https://api.elimunova.ai",
      "description": "Production server"
    }
  ],
  "components": {
    "securitySchemes": {
      "SessionAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "next-auth.session-token"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string" },
          "code": { "type": "string" },
          "details": { "type": "object" }
        }
      },
      "Package": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "price": { "type": "number" },
          "duration": { "type": "integer" },
          "maxTeachers": { "type": "integer" },
          "maxStudents": { "type": "integer" },
          "features": { "type": "array", "items": { "type": "string" } },
          "isActive": { "type": "boolean" }
        }
      },
      "Subscription": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "userId": { "type": "string", "nullable": true },
          "schoolId": { "type": "string", "nullable": true },
          "packageId": { "type": "string" },
          "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE", "TRIAL", "CANCELLED", "EXPIRED", "PAST_DUE"] },
          "startDate": { "type": "string", "format": "date-time" },
          "endDate": { "type": "string", "format": "date-time" },
          "trialEndsAt": { "type": "string", "format": "date-time", "nullable": true },
          "amount": { "type": "number" },
          "isTrial": { "type": "boolean" },
          "type": { "type": "string" },
          "paymentMethod": { "type": "string" },
          "stripeSubscriptionId": { "type": "string", "nullable": true },
          "package": { "$ref": "#/components/schemas/Package" }
        }
      },
      "LessonPlan": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "subject": { "type": "string" },
          "grade": { "type": "string" },
          "duration": { "type": "integer" },
          "objectives": { "type": "array", "items": { "type": "string" } },
          "content": { "type": "string" },
          "activities": { "type": "array", "items": { "type": "string" } },
          "assessment": { "type": "string" },
          "resources": { "type": "array", "items": { "type": "string" } },
          "teacherId": { "type": "string" },
          "schoolId": { "type": "string", "nullable": true },
          "isPublic": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Exam": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "subject": { "type": "string" },
          "grade": { "type": "string" },
          "duration": { "type": "integer" },
          "totalMarks": { "type": "integer" },
          "questions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "type": { "type": "string", "enum": ["MCQ", "SHORT_ANSWER", "ESSAY", "TRUE_FALSE"] },
                "question": { "type": "string" },
                "options": { "type": "array", "items": { "type": "string" } },
                "correctAnswer": { "type": "string" },
                "marks": { "type": "integer" },
                "difficulty": { "type": "string", "enum": ["EASY", "MEDIUM", "HARD"] },
                "topic": { "type": "string" }
              }
            }
          },
          "markingScheme": { "type": "string" },
          "teacherId": { "type": "string" },
          "schoolId": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "email": { "type": "string" },
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "role": { "type": "string", "enum": ["SUPER_ADMIN", "SCHOOL_ADMIN", "TEACHER", "STUDENT", "PARENT"] },
          "isActive": { "type": "boolean" },
          "avatar": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check endpoint",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "enum": ["ok", "healthy"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/packages": {
      "get": {
        "summary": "List all available subscription packages",
        "responses": {
          "200": {
            "description": "List of packages",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Package" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/subscription/status": {
      "get": {
        "summary": "Get current user's subscription status",
        "security": [{ "SessionAuth": [] }],
        "responses": {
          "200": {
            "description": "Subscription status",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Subscription" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/subscription/create-checkout": {
      "post": {
        "summary": "Create Stripe checkout session for subscription",
        "security": [{ "SessionAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["packageId", "successUrl", "cancelUrl"],
                "properties": {
                  "packageId": { "type": "string" },
                  "successUrl": { "type": "string", "format": "uri" },
                  "cancelUrl": { "type": "string", "format": "uri" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Checkout session created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "checkoutUrl": { "type": "string", "format": "uri" },
                    "sessionId": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/subscription/start-trial": {
      "post": {
        "summary": "Start a free trial for the current user",
        "security": [{ "SessionAuth": [] }],
        "responses": {
          "200": {
            "description": "Trial started successfully"
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/ai/chat": {
      "post": {
        "summary": "AI chat completion for tutoring",
        "security": [{ "SessionAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["message", "context"],
                "properties": {
                  "message": { "type": "string" },
                  "context": {
                    "type": "object",
                    "properties": {
                      "subject": { "type": "string" },
                      "grade": { "type": "string" },
                      "topic": { "type": "string" },
                      "mode": { "type": "string", "enum": ["tutor", "teacher_assistant", "explanation"] }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "AI response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "response": { "type": "string" },
                    "sources": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/ai/generate-lesson-plan": {
      "post": {
        "summary": "Generate a lesson plan using AI",
        "security": [{ "SessionAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["subject", "grade", "topic", "duration"],
                "properties": {
                  "subject": { "type": "string" },
                  "grade": { "type": "string" },
                  "topic": { "type": "string" },
                  "duration": { "type": "integer" },
                  "objectives": { "type": "array", "items": { "type": "string" } },
                  "curriculum": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generated lesson plan",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LessonPlan" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/ai/generate-exam": {
      "post": {
        "summary": "Generate an exam using AI",
        "security": [{ "SessionAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["subject", "grade", "topic", "duration", "totalMarks"],
                "properties": {
                  "subject": { "type": "string" },
                  "grade": { "type": "string" },
                  "topic": { "type": "string" },
                  "duration": { "type": "integer" },
                  "totalMarks": { "type": "integer" },
                  "questionTypes": {
                    "type": "array",
                    "items": { "type": "string", "enum": ["MCQ", "SHORT_ANSWER", "ESSAY", "TRUE_FALSE"] }
                  },
                  "difficulty": { "type": "string", "enum": ["EASY", "MEDIUM", "HARD"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generated exam",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Exam" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/ai/auto-mark": {
      "post": {
        "summary": "Auto-mark student submissions",
        "security": [{ "SessionAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["assignmentId", "studentAnswers"],
                "properties": {
                  "assignmentId": { "type": "string" },
                  "studentAnswers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "questionId": { "type": "string" },
                        "answer": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Marking results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "totalScore": { "type": "number" },
                    "maxScore": { "type": "number" },
                    "percentage": { "type": "number" },
                    "feedback": { "type": "string" },
                    "questionResults": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "questionId": { "type": "string" },
                          "score": { "type": "number" },
                          "maxScore": { "type": "number" },
                          "feedback": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/ai/generate-presentation": {
      "post": {
        "summary": "Generate a PowerPoint presentation using AI",
        "security": [{ "SessionAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["topic", "slideCount", "targetAudience"],
                "properties": {
                  "topic": { "type": "string" },
                  "slideCount": { "type": "integer", "minimum": 3, "maximum": 20 },
                  "targetAudience": { "type": "string" },
                  "tone": { "type": "string", "enum": ["formal", "engaging", "simple"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generated presentation URL",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "presentationUrl": { "type": "string", "format": "uri" },
                    "slides": { "type": "integer" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/ai/generate-image": {
      "post": {
        "summary": "Generate an educational image using AI",
        "security": [{ "SessionAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["prompt", "style"],
                "properties": {
                  "prompt": { "type": "string" },
                  "style": { "type": "string", "enum": ["educational", "diagram", "vivid", "cartoon", "natural"] },
                  "aspectRatio": { "type": "string", "enum": ["1:1", "16:9", "4:3"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generated image URL",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "imageUrl": { "type": "string", "format": "uri" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/lesson-plans": {
      "get": {
        "summary": "List lesson plans for the current teacher",
        "security": [{ "SessionAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer" }, "description": "Page number" },
          { "name": "limit", "in": "query", "schema": { "type": "integer" }, "description": "Items per page" }
        ],
        "responses": {
          "200": {
            "description": "List of lesson plans",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/LessonPlan" } },
                    "total": { "type": "integer" },
                    "page": { "type": "integer" },
                    "limit": { "type": "integer" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "summary": "Create a new lesson plan",
        "security": [{ "SessionAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LessonPlan" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Lesson plan created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LessonPlan" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/lesson-plans/{id}": {
      "get": {
        "summary": "Get a specific lesson plan",
        "security": [{ "SessionAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Lesson plan details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LessonPlan" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "summary": "Update a lesson plan",
        "security": [{ "SessionAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LessonPlan" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lesson plan updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LessonPlan" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "summary": "Delete a lesson plan",
        "security": [{ "SessionAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": { "description": "Lesson plan deleted" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "responses": {
    "Unauthorized": {
      "description": "Authentication required",
      "content": {
        "application/json": {
          "schema": { "$ref": "#/components/schemas/Error" }
        }
      }
    },
    "BadRequest": {
      "description": "Invalid request",
      "content": {
        "application/json": {
          "schema": { "$ref": "#/components/schemas/Error" }
        }
      }
    },
    "NotFound": {
      "description": "Resource not found",
      "content": {
        "application/json": {
          "schema": { "$ref": "#/components/schemas/Error" }
        }
      }
    }
  }
}