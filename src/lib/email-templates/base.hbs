<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
</head>
<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background-color: #f8fafc;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 600px; margin: 0 auto; background-color: #ffffff;">
    <!-- Header -->
    <tr>
      <td style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 40px 30px; text-align: center;">
        <img src="https://elimunova.ai/logo-black-removebg-preview.png" alt="ElimuNova AI" width="180" style="display: block; margin: 0 auto 20px;">
        <h1 style="color: #ffffff; margin: 0; font-size: 28px; font-weight: 700;">{{title}}</h1>
      </td>
    </tr>
    
    <!-- Content -->
    <tr>
      <td style="padding: 40px 30px;">
        <p style="color: #334155; font-size: 16px; line-height: 1.6; margin: 0 0 24px;">{{greeting}}</p>
        
        <div style="background-color: #f8fafc; border-left: 4px solid #667eea; padding: 20px; margin: 24px 0; border-radius: 0 8px 8px 0;">
          <p style="color: #475569; margin: 0; font-size: 15px; line-height: 1.6;">{{message}}</p>
        </div>
        
        {{#if action_url}}
        <div style="text-align: center; margin: 32px 0;">
          <a href="{{action_url}}" style="display: inline-block; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #ffffff; text-decoration: none; padding: 14px 32px; border-radius: 8px; font-weight: 600; font-size: 16px;">{{action_text}}</a>
        </div>
        {{/if}}
        
        <p style="color: #64748b; font-size: 14px; line-height: 1.6; margin: 24px 0 0;">{{footer_note}}</p>
      </td>
    </tr>
    
    <!-- Divider -->
    <tr>
      <td style="padding: 0 30px 24px;">
        <hr style="border: none; border-top: 1px solid #e2e8f0; margin: 0;">
      </td>
    </tr>
    
    <!-- Footer -->
    <tr>
      <td style="background-color: #f8fafc; padding: 24px 30px; text-align: center;">
        <p style="color: #94a3b8; font-size: 13px; margin: 0 0 12px;">
          © {{year}} ElimuNova AI. All rights reserved.
        </p>
        <p style="color: #94a3b8; font-size: 12px; margin: 0;">
          <a href="https://elimunova.ai/privacy" style="color: #94a3b8; text-decoration: underline;">Privacy Policy</a> •
          <a href="https://elimunova.ai/terms" style="color: #94a3b8; text-decoration: underline;">Terms of Service</a> •
          <a href="https://elimunova.ai/contact" style="color: #94a3b8; text-decoration: underline;">Contact Us</a>
        </p>
        <p style="color: #94a3b8; font-size: 12px; margin: 12px 0 0;">
          Developed by <a href="https://infinititechsolutions.org/" style="color: #667eea;">InfinitiTech Solutions</a>
        </p>
      </td>
    </tr>
  </table>
</body>
</html>