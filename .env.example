# ── Required (app crashes at boot without these) ────────────────────────
# Database
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-string"

# Optional: set to "1" to skip env validation (CI smoke builds)
# SKIP_ENV_CHECK="1"

# AI Providers (at least one required)
OPENAI_API_KEY="sk-..."
CEREBRAS_API_KEY="csk-..."
DEEPSEEK_API_KEY="sk-..."
GROQ_API_KEY="gsk_..."
GEMINI_API_KEY="..."

# Supabase (optional - PDF/PPTX storage)
NEXT_PUBLIC_SUPABASE_URL="https://project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="..."
SUPABASE_SERVICE_ROLE_KEY="..."

# Image Generation (optional)
OPENAI_DALLE_API_KEY="sk-proj-..."
STABILITY_API_KEY="sk-..."

# Cloudinary (optional - AI image storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Stripe (optional - billing)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# M-Pesa Daraja API (optional - mobile money payments)
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_PASSKEY=""
MPESA_SHORTCODE=""
MPESA_ENVIRONMENT="sandbox"

# PayPal REST API (optional - PayPal payments)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENVIRONMENT="sandbox"

# Zoom Meeting SDK (optional - in-app video conferencing)
ZOOM_SDK_KEY=""
ZOOM_SDK_SECRET=""

# Zoom Server-to-Server OAuth (required for auto-creating/managing meetings)
# 1. Go to https://marketplace.zoom.us/
# 2. Create a "Server-to-Server OAuth" app
# 3. Copy Account ID, Client ID, and Client Secret
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""

# Zoom Webhook Secret (for recording notifications)
# In your Zoom app → Feature → Event Subscriptions → Add "Recording completed" event
ZOOM_WEBHOOK_SECRET=""

# Vercel Blob (optional - file storage)
BLOB_READ_WRITE_TOKEN=""

# Email (SMTP – for sending credential emails to parents/students)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@yourdomain.com"

# Performance
NEXT_DISABLE_TURBOPACK=1

# Redis (optional — falls back to in-memory cache)
REDIS_URL=""

# Resend (alternative email provider)
RESEND_API_KEY=""

# Stock Image APIs
UNSPLASH_ACCESS_KEY=""

# WhatsApp Integration
WHATSAPP_PROVIDER=""  # twilio, africastalking
WHATSAPP_AUTH_TOKEN=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
AFRICASTALKING_API_KEY=""
AFRICASTALKING_USERNAME=""
AFRICASTALKING_FROM=""

# AI Model Overrides (optional — defaults shown)
# CEREBRAS_MODEL="gemma-4-31b"
# DEEPSEEK_MODEL="deepseek-chat"
# GEMINI_MODEL="gemini-2.0-flash"
# GROQ_MODEL="llama-3.3-70b-versatile"
# OPENAI_MODEL="gpt-4o-mini"
# PREMIUM_OPENAI_MODEL="gpt-4o"
# PREMIUM_GEMINI_MODEL="gemini-2.0-flash"
# OPENROUTER_MODEL="openai/gpt-4o-mini"

# OpenRouter (alternative AI provider)
OPENROUTER_API_KEY=""
