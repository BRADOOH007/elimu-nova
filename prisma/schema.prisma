// Model for external database connections
model ExternalDatabase {
  id          String       @id @default(cuid())
  name        String
  type        DatabaseType @default(POSTGRESQL)
  host        String
  port        Int
  database    String
  username    String
  password    String
  ssl         Boolean      @default(true)
  isActive    Boolean      @default(true)
  description String?
  config      Json? // Additional database-specific config
  lastTested  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([type])
  @@map("external_databases")
}

enum DatabaseType {
  POSTGRESQL
  MYSQL
  MONGODB
  SQLSERVER
  REDIS
  OTHER
}

// Email/SMS service configuration
model CommunicationService {
  id        String                @id @default(cuid())
  name      String
  type      CommunicationType
  provider  CommunicationProvider
  apiKey    String?
  apiSecret String?
  fromEmail String?
  fromPhone String?
  isActive  Boolean               @default(true)
  config    Json?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@map("communication_services")
}

enum CommunicationType {
  EMAIL
  SMS
  BOTH
}

enum CommunicationProvider {
  SENDGRID
  MAILGUN
  POSTMARK
  TWILIO
  AFRICASTALKING
  NEXMO
  OTHER
}

// Model for Redis configuration
model RedisConfig {
  id        String   @id @default(cuid())
  name      String
  host      String
  port      Int
  username  String?
  password  String?
  db        Int      @default(0)
  ssl       Boolean  @default(true)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("redis_configs")
}

// Teacher-generated notes from AI lesson notes feature
model TeacherNote {
  id           String   @id @default(cuid())
  title        String
  content      String // JSON content of the notes
  subject      String
  grade        String
  topic        String?
  noteType     String   @default("detailed") // summary, detailed, study-guide, quick-reference, interactive
  teacherId    String
  lessonPlanId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  teacher    Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  lessonPlan LessonPlan? @relation(fields: [lessonPlanId], references: [id], onDelete: SetNull)

  @@index([teacherId, createdAt])
  @@index([teacherId, subject])
  @@index([subject, grade])
  @@map("teacher_notes")
}

// Super admin audit log for industrial-grade change tracking
model AdminAuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String // CREATE, UPDATE, DELETE
  entity    String // "school", "user", "package", "billing", "system_setting"
  entityId  String?
  summary   String
  changes   String? // JSON diff of before/after
  ipAddress String?
  createdAt DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

// Exam Lockdown / Proctoring
enum ViolationType {
  TAB_SWITCH
  FULLSCREEN_EXIT
  COPY_PASTE
  RIGHT_CLICK
  OTHER
}

enum ReentryStatus {
  NONE
  PENDING
  APPROVED
  DENIED
}

model ExamSession {
  id            String        @id @default(cuid())
  assignmentId  String
  studentId     String
  startedAt     DateTime      @default(now())
  endedAt       DateTime?
  timeLimitMins Int?
  reentryStatus ReentryStatus @default(NONE)

  assignment Assignment          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  violations LockdownViolation[]

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([assignmentId])
  @@index([reentryStatus])
  @@map("exam_sessions")
}

model ContactMessage {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
  @@map("contact_messages")
}

model LockdownViolation {
  id        String        @id @default(cuid())
  sessionId String
  type      ViolationType
  details   String?
  createdAt DateTime      @default(now())

  session ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("lockdown_violations")
}

// ============================================
// MASTERY, SPACED REPETITION & COURSE CHALLENGE
// ============================================

enum MasteryLevel {
  NOT_STARTED
  BEGINNER
  DEVELOPING
  PROFICIENT
  MASTERED
}

// Per-unit (strand) mastery tracking — Khan Academy style
model UnitMastery {
  id               String       @id @default(cuid())
  studentId        String
  strandId         String? // links to CurriculumStrand.id if DB-backed
  subject          String
  unitName         String // strand name or fallback topic name
  grade            String?
  masteryScore     Int          @default(0) // 0-100
  masteryLevel     MasteryLevel @default(NOT_STARTED)
  totalQuestions   Int          @default(0)
  correctAnswers   Int          @default(0)
  studyTimeMins    Int          @default(0)
  quizzesTaken     Int          @default(0)
  lessonsCompleted Int          @default(0)
  lastPracticedAt  DateTime?
  nextReviewAt     DateTime? // for spaced repetition
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, subject, unitName])
  @@index([studentId, subject])
  @@index([studentId, nextReviewAt])
  @@map("unit_mastery")
}

// Skill prerequisite graph for knowledge map
model SkillPrerequisite {
  id               String @id @default(cuid())
  skillName        String
  subject          String
  prerequisiteName String // must learn this before the skill
  prerequisiteType String @default("required") // "required", "recommended"
  order            Int    @default(0)

  @@unique([skillName, subject, prerequisiteName])
  @@index([subject])
  @@map("skill_prerequisites")
}

// Spaced repetition review schedule
model ReviewSchedule {
  id           String    @id @default(cuid())
  studentId    String
  subject      String
  topic        String
  unitName     String?
  easeFactor   Float     @default(2.5) // SM-2 ease factor
  intervalDays Int       @default(0) // current interval
  repetitions  Int       @default(0) // successful repetitions
  nextReviewAt DateTime // when to review
  lastReviewAt DateTime?
  quality      Int       @default(0) // last review quality (0-5)
  totalReviews Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, subject, topic])
  @@index([studentId, nextReviewAt])
  @@index([studentId, subject])
  @@map("review_schedules")
}

// Persistent AI memory for a student — lets the tutor "keep learning
// about them" across conversations. Stores durable facts (interests,
// struggles, strengths, goals, preferences) extracted from chats,
// plus a short natural-language summary. Injected into tutor prompts.
model StudentMemory {
  id        String   @id @default(cuid())
  studentId String   @unique
  summary   String   @default("") // AI-written short summary of the learner
  facts     Json? // Array<{ id, fact, category, source, createdAt, lastSeenAt }>
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_memory")
}

// Per-topic progress for the sequential "learning path" —
// tracks where a student left off so they can resume a lesson
// they didn't finish, and which topics are complete/next.
model TopicProgress {
  id           String         @id @default(cuid())
  studentId    String
  subject      String
  grade        String         @default("Grade 4")
  strandName   String // parent strand (e.g. "Numbers")
  topicName    String // substrand / topic (e.g. "Whole Numbers")
  order        Int            @default(0) // position within the subject path
  status       ProgressStatus @default(NOT_STARTED)
  lastContent  String? // cached generated lesson markdown for instant resume
  lastPosition Int            @default(0) // approximate scroll/lesson position (0-100)
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, grade, subject, topicName])
  @@index([studentId, grade, subject, status])
  @@map("topic_progress")
}

// Course challenge — comprehensive end-of-unit test
model CourseChallenge {
  id             String    @id @default(cuid())
  studentId      String
  subject        String
  unitName       String
  grade          String?
  totalQuestions Int       @default(0)
  correctAnswers Int       @default(0)
  score          Int       @default(0) // 0-100
  timeTakenMins  Int       @default(0)
  passed         Boolean   @default(false) // true if score >= 70
  questions      Json? // the questions that were asked
  answers        Json? // student answers
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, subject])
  @@index([studentId, unitName])
  @@map("course_challenges")
}

// Writing coach submissions
model WritingSubmission {
  id            String    @id @default(cuid())
  studentId     String
  subject       String
  topic         String
  title         String?
  content       String    @db.Text
  wordCount     Int       @default(0)
  feedback      Json? // { grammar: {...}, structure: {...}, content: {...}, overall: string }
  score         Int? // 0-100
  revisionCount Int       @default(0)
  status        String    @default("draft") // "draft", "submitted", "reviewed"
  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, subject])
  @@map("writing_submissions")
}

// Senior essay/Writing submissions (GED adult learners — RLA extended response
// and adult literacy prompts). Mirrors WritingSubmission but scoped to seniors.
model SeniorWritingSubmission {
  id            String    @id @default(cuid())
  seniorStudentId String
  subject       String
  topic         String
  title         String?
  content       String    @db.Text
  wordCount     Int       @default(0)
  feedback      Json?
  score         Int?
  status        String    @default("draft") // "draft", "submitted", "reviewed"
  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  seniorStudent SeniorStudent @relation(fields: [seniorStudentId], references: [id], onDelete: Cascade)

  @@index([seniorStudentId, subject])
  @@map("senior_writing_submissions")
}

// Curriculum Intelligence — Document Library for AI knowledge base
model DocumentLibrary {
  id           String   @id @default(cuid())
  title        String
  documentType String // "scheme_of_work" | "lesson_plan" | "exam" | "curriculum_guide" | "resource"
  grade        String
  subject      String
  term         Int?
  strandName   String?
  content      String   @db.Text // Full extracted text
  metadata     Json? // { strandCount, substrandCount, outcomeCount, weekCount, formattingStyle, sections }
  sourceId     String? // Original uploaded file ID
  teacherId    String?
  isProcessed  Boolean  @default(true)
  uploadedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([grade, subject, documentType])
  @@index([teacherId])
  @@map("document_library")
}

model QuizResult {
  id             String   @id @default(cuid())
  userId         String
  subject        String
  topic          String?
  scorePercent   Int
  correctCount   Int
  totalQuestions Int
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@map("quiz_results")
}

model PracticeAttempt {
  id        String   @id @default(cuid())
  userId    String
  topicId   String?
  subject   String?
  isCorrect Boolean
  answer    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@map("practice_attempts")
}

model CurriculumIngestionLog {
  id           String   @id @default(cuid())
  url          String   @unique
  title        String
  grade        String?
  subject      String?
  status       String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  errorMessage String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@map("curriculum_ingestion_logs")
}

// ─── Digital Library (student-facing, curriculum-agnostic) ───

model Book {
  id           String   @id @default(cuid())
  title        String
  author       String?
  description  String?  @db.Text
  coverUrl     String?
  content      String?  @db.Text // Full plain-text for the in-app reader + text-to-speech
  fileUrl      String?           // Optional PDF/EPUB for download or embedded viewing
  audioUrl     String?           // Optional narrated audio (premium listening)
  category     String            // e.g. "Stories", "Science", "History", "Mathematics"
  subjects     String[]          // Curriculum-agnostic subject tags
  gradeMin     Int?
  gradeMax     Int?
  language     String   @default("English")
  readingLevel String?           // Beginner | Intermediate | Advanced
  isFeatured   Boolean  @default(false)
  isPublished  Boolean  @default(false)
  viewCount    Int      @default(0)
  source       String   @default("upload") // upload | public-domain | ai-generated
  addedBy      String?            // userId of the admin/teacher who added it
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([isPublished, isFeatured])
  @@index([language])
  @@map("books")
}

model BookProgress {
  id          String   @id @default(cuid())
  studentId   String   // Student.id (manual FK, consistent with QuizResult.userId)
  bookId      String
  position    Int      @default(0)  // paragraph/character offset
  progressPct Float    @default(0)
  completed   Boolean  @default(false)
  lastReadAt  DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([studentId, bookId])
  @@index([studentId])
  @@index([bookId])
  @@map("book_progress")
}

model BookRating {
  id        String   @id @default(cuid())
  studentId String   // Student.id (manual FK)
  bookId    String
  rating    Int      // 1-5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, bookId])
  @@index([bookId])
  @@map("book_ratings")
}

model ReadingLog {
  id        String   @id @default(cuid())
  studentId String   // Student.id (manual FK)
  bookId    String?
  minutes   Int      @default(0)
  date      String   // YYYY-MM-DD (UTC) for daily streak tracking
  createdAt DateTime @default(now())

  @@index([studentId, date])
  @@map("reading_logs")
}
