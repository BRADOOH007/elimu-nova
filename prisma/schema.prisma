// ──────────────────────────────────────────────────────────────────
// Prisma Schema — ElimuNova Database (PostgreSQL on Neon)
// Key design decisions:
//   • schoolId is nullable on Teacher/Student/Class/Parent —
//     independent (school-less) users coexist with school-managed
//   • deletedAt on Teacher/Student/Class enables soft delete
//   • Roles: SUPER_ADMIN > SCHOOL_ADMIN > TEACHER > STUDENT > PARENT
//   • All tables use @@map for explicit snake_case table names
// ──────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT
  SENIOR_STUDENT
  SENIOR_TEACHER
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  EXPIRED
  TRIAL
  TRIAL_EXPIRED
}

enum AssignmentStatus {
  PENDING
  SUBMITTED
  GRADED
  OVERDUE
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  NEEDS_REVIEW
}

enum ReportType {
  ANALYTICS
  FINANCIAL
  ACADEMIC
  USER_ACTIVITY
  SYSTEM_HEALTH
  CUSTOM
}

enum ReportStatus {
  DRAFT
  GENERATING
  COMPLETED
  FAILED
  EXPIRED
}

// ── Core User ────────────────────────────────────────────────────
// Central identity table — every person (of any role) is a User first.
// Role-specific extensions (Teacher, Student, etc.) link via userId FK.
// address field may contain encrypted initial password after '---' separator.

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  role          UserRole
  avatar        String?
  phone         String?
  address       String?
  isActive      Boolean   @default(true)
  loginAttempts Int       @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relationships
  schoolAdmin             SchoolAdmin?
  teacher                 Teacher?
  student                 Student?
  parent                  Parent?
  seniorStudent           SeniorStudent?
  seniorTeacher           SeniorTeacher?
  superAdmin              SuperAdmin?
  notifications           Notification[]   @relation("NotificationUser")
  sentNotifications       Notification[]   @relation("NotificationSender")
  sessions                Session[]
  generatedReports        Report[]         @relation("ReportGeneratedBy")
  updatedSystemSettings   SystemSettings[] @relation("SystemSettingsUpdatedBy")
  updatedSchoolSettings   SchoolSettings[] @relation("SchoolSettingsUpdatedBy")
  securityLogs            SecurityLog[]    @relation("SecurityLogUser")
  resolvedSecurityLogs    SecurityLog[]    @relation("SecurityLogResolver")
  createdSecurityPolicies SecurityPolicy[] @relation("SecurityPolicyCreatedBy")
  updatedSecurityPolicies SecurityPolicy[] @relation("SecurityPolicyUpdatedBy")
  accounts                Account[]
  preferences             UserPreference?
  searchHistory           SearchHistory[]
  activities              Activity[]
  createdMeetings         Meeting[]
  subscriptions           Subscription[]
  adminAuditLogs          AdminAuditLog[]

  // AI Generated Content
  generatedImages AIGeneratedImage[]
  imageUsage      AIImageUsage[]

  @@map("users")
}

model SuperAdmin {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("super_admins")
}

// ── School ───────────────────────────────────────────────────────
// A school groups Teachers, Students, Classes, and Parents.
// Nullable schoolId on child models enables school-less independent users.

model District {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?  @unique
  address   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schools School[]

  @@map("districts")
}

model School {
  id         String   @id @default(cuid())
  name       String
  address    String
  phone      String?
  email      String?
  website    String?
  logo       String?
  districtId String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  district District? @relation(fields: [districtId], references: [id])

  // Relationships
  schoolAdmin       SchoolAdmin?
  teachers          Teacher[]
  students          Student[]
  classes           Class[]
  subscriptions     Subscription[]
  packages          Package[]
  reports           Report[]
  securityLogs      SecurityLog[]        @relation("SecurityLogSchool")
  activities        Activity[]
  meetings          Meeting[]
  schedules         Schedule[]
  academicCalendars AcademicCalendar[]
  settings          SchoolSettings[]
  schemesOfWork     SchemeOfWork[]
  sharedSchemes     SharedSchemeOfWork[]

  // Curricula & Courses
  curriculums   Curriculum[]
  courses       Course[]
  learningAreas LearningArea[]

  // AI Generated Images
  generatedImages AIGeneratedImage[]

  // Notifications
  notifications Notification[]

  // Parents
  parents Parent[]

  @@map("schools")
}

model SchoolAdmin {
  id       String @id @default(cuid())
  userId   String @unique
  schoolId String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_admins")
}

// ── Teacher ──────────────────────────────────────────────────────
// Links to User (auth) and School (nullable for independent teachers).
// Has template fields for AI-generated content personalization.
// Soft-deletable via deletedAt.

model Teacher {
  id       String  @id @default(cuid())
  userId   String  @unique
  schoolId String?
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  school   School? @relation(fields: [schoolId], references: [id])

  // Template text for AI-generated content
  lessonPlanTemplate   String?
  schemeOfWorkTemplate String?
  examTemplate         String?
  assignmentTemplate   String?
  curriculumTemplate   String?

  // Relationships
  students           Student[]
  classes            Class[]
  schemesOfWork      SchemeOfWork[]
  lessonPlans        LessonPlan[]
  assignments        Assignment[]
  studentProgress    StudentProgress[]
  sharedSchemes      SharedSchemeOfWork[]
  sharedLessonPlans  SharedLessonPlan[]
  schedules          Schedule[]
  resources          Resource[]
  aiGeneratedContent AIGeneratedContent[]

  // Courses
  courseAssignments TeacherCourseAssignment[]

  // AI Generated Images
  generatedImages AIGeneratedImage[]

  // Generated notes
  notes TeacherNote[]

  // Document Library for curriculum intelligence
  documentLibrary DocumentLibrary[]

  // CBC teaching assignment fields
  gradeLevels String[] @default([])
  subjects    String[] @default([])

  // Department / HOD assignment
  departmentHod String?

  // Multi-subject teaching assignments (junction table)
  teacherSubjectAssignments TeacherSubjectAssignment[]

  deletedAt DateTime?

  @@map("teachers")
}

// ── TeacherSubjectAssignment ────────────────────────────────────
// Junction table linking Teacher → Class → Subject.
// A teacher can teach Math in Grade 4 & 5, Science only in Grade 6.
// The teacher's dashboard filters students through this mapping:
//   TeacherSubjectAssignment → Class → Students

model TeacherSubjectAssignment {
  id        String @id @default(cuid())
  teacherId String
  classId   String
  subject   String // e.g. "Mathematics", "Integrated Science"

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classId, subject])
  @@map("teacher_subject_assignments")
}

// ── Class ────────────────────────────────────────────────────────
// Belongs to a Teacher and optionally a School. Groups Students.
// Soft-deletable via deletedAt.

model Class {
  id          String   @id @default(cuid())
  name        String
  description String?
  subject     String
  grade       String
  schoolId    String?
  teacherId   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  school                    School?                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher                   Teacher                    @relation(fields: [teacherId], references: [id])
  students                  Student[]
  assignments               Assignment[]
  sharedAIContent           SharedAIContentWithClass[]
  schedules                 Schedule[]
  teacherSubjectAssignments TeacherSubjectAssignment[]

  // AI Generated Images
  generatedImages AIGeneratedImage[]

  // Shared presentations
  sharedPresentations AIGeneratedContent[]

  deletedAt DateTime?

  @@map("classes")
}

// ── Student ──────────────────────────────────────────────────────
// Links to User, Teacher, School, and Class (all nullable for flexibility).
// Multi-subject support via String[] subjects field.
// Parent relationships are many-to-many through ParentStudent.
// Soft-deletable via deletedAt.

model Student {
  id        String   @id @default(cuid())
  userId    String   @unique
  schoolId  String?
  teacherId String?
  classId   String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  school    School?  @relation(fields: [schoolId], references: [id])
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  class     Class?   @relation(fields: [classId], references: [id])

  // Learning areas / subjects assigned to this student (multi-subject support)
  subjects String[] @default([])

  // Senior School pathway selection (Grade 10-12)
  pathway            String? // STEM | TVET | SOCIAL_SCIENCES | ARTS_AND_SPORTS
  tvetSpecialization String? // e.g. "electrical_electronics"
  stemTrack          String? // e.g. "TECHNICAL_ENGINEERING"

  // Relationships
  assignments       Assignment[]
  studentProgress   StudentProgress[]
  submissions       Submission[]
  sharedSchemes     SharedSchemeOfWork[]
  sharedLessonPlans SharedLessonPlan[]
  studySessions     StudySession[]
  analytics         StudentAnalytics?
  aiTutorSessions   AITutorSession[]
  resources         Resource[]
  sharedAIContent   SharedAIContent[]
  parents           ParentStudent[]

  // Wellness
  wellnessCheckIns WellnessCheckIn[]

  // Courses
  courseEnrollments CourseEnrollment[]

  // AI Generated Images
  generatedImages AIGeneratedImage[]

  // Exam lockdown sessions
  examSessions ExamSession[]

  // Mastery & Spaced Repetition
  unitMasteries      UnitMastery[]
  reviewSchedules    ReviewSchedule[]
  topicProgress      TopicProgress[]
  courseChallenges   CourseChallenge[]
  writingSubmissions WritingSubmission[]

  // Persistent AI memory
  memory StudentMemory?

  deletedAt DateTime?

  @@map("students")
}

// ── Parent ───────────────────────────────────────────────────────
// Links to User and optionally School (via schoolId for scoped access).
// Children are linked through ParentStudent junction table.
// Parent schoolId was added via migration for meeting access scoping.

model Parent {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId String?

  school School? @relation(fields: [schoolId], references: [id])

  // Relationships
  students ParentStudent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("parents")
}

// ── Parent-Student Junction ──────────────────────────────────────
// Many-to-many: a Parent can have multiple children, a Student can
// have multiple parents. Unique constraint prevents duplicates.

model ParentStudent {
  id        String  @id @default(cuid())
  parentId  String
  studentId String
  parent    Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentId, studentId])
  @@map("parent_students")
}

// ── Senior Student (Adult Learner / GED) ──────────────────────────
// Parallel to Student, but for adult learners pursuing the US General
// Education Diploma (GED). School-less by design — no schoolId/teacherId/
// classId. Owns GED subject progress, supplemental course enrollments,
// and any issued GED preparation certificates.

model SeniorStudent {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ageBracket          String? // e.g. "16-19" | "20-29" | "30-49" | "50+"
  priorEducation      String? // e.g. "None" | "Some Primary" | "Some Secondary"
  englishLevel        String? // e.g. "Beginner" | "Intermediate" | "Advanced" | "Native"
  goals               String[] @default([])
  selectedGEDSubjects String[] @default([]) // subset of the 4 GED subjects
  isGEDReady          Boolean  @default(false)

  // Account access — controlled by Super Admin. PENDING = awaiting approval,
  // FREEMIUM = approved with free limited access, LOCKED = dashboard locked
  // (student sees the subscribe screen).
  approvalStatus String    @default("PENDING") // PENDING | FREEMIUM | LOCKED
  approvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  gedSubjectProgress GEDSubjectProgress[]
  gedPracticeTests   GEDPracticeTest[]
  courseEnrollments  SeniorCourseEnrollment[]
  certificates       GEDCertificate[]
  essays             SeniorWritingSubmission[]

  @@map("senior_students")
}

// Per-subject GED progress (4 subjects, 100–200 official score scale)
model GEDSubjectProgress {
  id                 String   @id @default(cuid())
  seniorStudentId    String
  subject            String // Mathematical Reasoning | Reasoning Through Language Arts | Science | Social Studies
  completedLessons   Int      @default(0)
  completedLessonIds String[] @default([])
  totalLessons       Int      @default(0)
  practiceScore      Int? // 100–200 scale from practice tests
  mastery            Int      @default(0) // 0–100 derived mastery
  isReady            Boolean  @default(false) // mastery >= GED-ready threshold
  updatedAt          DateTime @updatedAt

  seniorStudent SeniorStudent @relation(fields: [seniorStudentId], references: [id], onDelete: Cascade)

  @@unique([seniorStudentId, subject])
  @@map("ged_subject_progress")
}

// A timed GED-style practice test attempt for one subject. The score (100-200
// official GED scale) is written back to GEDSubjectProgress.practiceScore and a
// passing result flags the subject as GED-ready, giving students measurable,
// visible progress toward exam readiness.
model GEDPracticeTest {
  id              String    @id @default(cuid())
  seniorStudentId String
  subject         String // one of the 4 GED subjects
  questions       Json
  answers         Json?
  score           Int? // official 100-200 scale (null until completed)
  correctAnswers  Int       @default(0)
  totalQuestions  Int       @default(0)
  passed          Boolean   @default(false)
  timeLimitMins   Int?
  timeTakenMins   Int?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  seniorStudent SeniorStudent @relation(fields: [seniorStudentId], references: [id], onDelete: Cascade)

  @@index([seniorStudentId, subject])
  @@index([completedAt])
  @@map("ged_practice_tests")
}

// Enrollment of a senior student in a supplemental course (computer literacy,
// AI literacy, etc.) — parallels CourseEnrollment but scoped to adults.
model SeniorCourseEnrollment {
  id                 String   @id @default(cuid())
  seniorStudentId    String
  courseId           String
  enrolledAt         DateTime @default(now())
  progress           Int      @default(0) // 0-100
  completedLessonIds String[] @default([])
  status             String   @default("ACTIVE") // ACTIVE, COMPLETED, DROPPED

  seniorStudent SeniorStudent @relation(fields: [seniorStudentId], references: [id], onDelete: Cascade)
  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([seniorStudentId, courseId])
  @@map("senior_course_enrollments")
}

// GED Preparation Certificate of Completion — issued when a senior student
// reaches GED-ready across all four subjects. Documents mastery of the prep
// program (not an official GED Testing Service credential).
model GEDCertificate {
  id              String   @id @default(cuid())
  seniorStudentId String
  certNumber      String   @unique
  awardedAt       DateTime @default(now())
  subjectScores   Json?
  pdfUrl          String?
  status          String   @default("ISSUED") // ISSUED, REVOKED
  createdAt       DateTime @default(now())

  seniorStudent SeniorStudent @relation(fields: [seniorStudentId], references: [id], onDelete: Cascade)

  @@map("ged_certificates")
}

// ── Senior Teacher (Adult Education Instructor) ────────────────────
// Separate from Teacher so adult-education instructors can be onboarded
// independently. Conducts live lessons for senior (GED) students.

model SeniorTeacher {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  specialties String[] @default([]) // e.g. "Mathematical Reasoning", "Computer Literacy"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  schedules Schedule[]

  @@map("senior_teachers")
}

model Package {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  duration    Int // in days
  maxTeachers Int
  maxStudents Int
  features    String[] // JSON array of features
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  schools       School[]
  subscriptions Subscription[]

  @@map("packages")
}

model Subscription {
  id                   String             @id @default(cuid())
  schoolId             String? // Optional for independent users
  userId               String? // For independent user subscriptions
  packageId            String
  paymentMethodId      String?
  status               SubscriptionStatus @default(ACTIVE)
  startDate            DateTime
  endDate              DateTime
  amount               Float
  type                 String             @default("SUBSCRIPTION")
  paymentMethod        String             @default("MANUAL")
  transactionId        String?
  stripeSubscriptionId String? // Stripe subscription ID
  stripeCustomerId     String? // Stripe customer ID
  isTrial              Boolean            @default(false)
  trialEndsAt          DateTime?
  isFreemium           Boolean            @default(false)
  notes                String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // Relationships
  school           School?        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user             User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  package          Package        @relation(fields: [packageId], references: [id])
  paymentMethodRef PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  invoices         Invoice[]

  @@map("subscriptions")
}

model PaymentMethod {
  id          String   @id @default(cuid())
  name        String
  type        String // CREDIT_CARD, BANK_TRANSFER, MOBILE_MONEY, CASH
  isActive    Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  subscriptions Subscription[]
  invoices      Invoice[]

  @@map("payment_methods")
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  subscriptionId  String
  amount          Float
  taxAmount       Float         @default(0)
  totalAmount     Float
  status          InvoiceStatus @default(PENDING)
  dueDate         DateTime
  paidDate        DateTime?
  paymentMethodId String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relationships
  subscription  Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  @@map("invoices")
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model Report {
  id          String       @id @default(cuid())
  title       String
  description String?
  type        ReportType   @default(ANALYTICS)
  status      ReportStatus @default(DRAFT)
  content     String // JSON content for report data
  filters     String? // JSON filters applied
  generatedBy String // User ID who generated the report
  schoolId    String? // Optional: school-specific report
  isPublic    Boolean      @default(false)
  scheduledAt DateTime? // For scheduled reports
  expiresAt   DateTime? // Optional expiration date
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relationships
  generatedByUser User    @relation("ReportGeneratedBy", fields: [generatedBy], references: [id], onDelete: Cascade)
  school          School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model SystemSettings {
  id          String   @id @default(cuid())
  key         String   @unique // Setting key (e.g., 'site_name', 'maintenance_mode')
  value       String // Setting value (JSON string for complex values)
  type        String   @default("string") // Type: string, number, boolean, json, array
  category    String   @default("general") // Category: general, security, email, notifications, etc.
  description String? // Human-readable description
  isPublic    Boolean  @default(false) // Whether this setting is public (accessible to non-admins)
  isEditable  Boolean  @default(true) // Whether this setting can be edited
  updatedBy   String // User ID who last updated this setting
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  updatedByUser User @relation("SystemSettingsUpdatedBy", fields: [updatedBy], references: [id], onDelete: Cascade)

  @@map("system_settings")
}

model SchoolSettings {
  id          String   @id @default(cuid())
  schoolId    String
  key         String // Setting key (e.g., 'school_theme', 'notification_preferences')
  value       String // Setting value (JSON string for complex values)
  type        String   @default("string") // Type: string, number, boolean, json, array
  category    String   @default("general") // Category: general, notifications, appearance, etc.
  description String? // Human-readable description
  isEditable  Boolean  @default(true) // Whether this setting can be edited
  updatedBy   String // User ID who last updated this setting
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  school        School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  updatedByUser User   @relation("SchoolSettingsUpdatedBy", fields: [updatedBy], references: [id], onDelete: Cascade)

  @@unique([schoolId, key])
  @@map("school_settings")
}

model SecurityLog {
  id          String            @id @default(cuid())
  eventType   SecurityEventType
  severity    SecuritySeverity  @default(MEDIUM)
  description String
  ipAddress   String?
  userAgent   String?
  userId      String? // Optional - for user-related events
  schoolId    String? // Optional - for school-specific events
  metadata    String? // JSON metadata for additional context
  resolved    Boolean           @default(false)
  resolvedBy  String? // User ID who resolved the issue
  resolvedAt  DateTime?
  createdAt   DateTime          @default(now())

  // Relationships
  user     User?   @relation("SecurityLogUser", fields: [userId], references: [id], onDelete: SetNull)
  school   School? @relation("SecurityLogSchool", fields: [schoolId], references: [id], onDelete: SetNull)
  resolver User?   @relation("SecurityLogResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@map("security_logs")
}

model SystemIncident {
  id          String           @id @default(cuid())
  severity    IncidentSeverity @default(MEDIUM)
  category    IncidentCategory @default(OTHER)
  status      IncidentStatus   @default(OPEN)
  title       String
  description String
  source      String? // Route path, service name, or component
  dedupeKey   String // Stable key for deduping repeat occurrences of the same issue
  count       Int              @default(1)
  firstSeen   DateTime         @default(now())
  lastSeen    DateTime         @default(now())
  metadata    Json?
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([dedupeKey, status])
  @@map("system_incidents")
}

model ApiLog {
  id         String   @id @default(cuid())
  method     String
  path       String
  status     Int
  durationMs Int?
  userId     String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([status, createdAt])
  @@map("api_logs")
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentCategory {
  DATABASE
  AI_SERVICE
  API_ERROR
  ROUTE_404
  RATE_LIMIT
  SECURITY
  PAYMENT
  PERFORMANCE
  OTHER
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model SecurityPolicy {
  id          String             @id @default(cuid())
  name        String
  description String?
  policyType  SecurityPolicyType
  rules       String // JSON rules configuration
  isActive    Boolean            @default(true)
  priority    Int                @default(0) // Higher number = higher priority
  createdBy   String // User ID who created the policy
  updatedBy   String // User ID who last updated the policy
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  // Relationships
  createdByUser User @relation("SecurityPolicyCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  updatedByUser User @relation("SecurityPolicyUpdatedBy", fields: [updatedBy], references: [id], onDelete: Cascade)

  @@map("security_policies")
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  PASSWORD_CHANGE
  PERMISSION_DENIED
  SUSPICIOUS_ACTIVITY
  DATA_BREACH_ATTEMPT
  UNAUTHORIZED_ACCESS
  SYSTEM_INTRUSION
  MALWARE_DETECTED
  POLICY_VIOLATION
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  TWO_FACTOR_ENABLED
