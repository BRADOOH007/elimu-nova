// ── SkillMastery (per-concept mastery tracking) ──────────────
// Replaces the single masteryScore with granular tracking per
// learning outcome, enabling targeted teach/practice/quiz per
// concept rather than whole-topic modes.

model SkillMastery {
  id              String    @id @default(cuid())
  progressId      String
  skillName       String // e.g. "Photosynthesis equation", "Cell division phases"
  skillCategory   String // "knowledge", "comprehension", "application" (Bloom's)
  masteryScore    Int       @default(0) // 0-100 per skill
  timesCorrect    Int       @default(0)
  timesTested     Int       @default(0)
  lastPracticedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relationships
  progress StudentProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  @@unique([progressId, skillName])
  @@index([progressId, masteryScore])
  @@map("skill_mastery")
}

