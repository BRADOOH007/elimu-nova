  @@unique([schemeOfWorkId, studentId])
  @@map("shared_schemes_of_work")
}

// ── KICD content library ─────────────────────────────────────────────────
// Structured store for CBC/CBE termly schemes-of-work and lesson plans in the
// official KICD format. Each row is one week's lesson within a term. Supports
// both imported documents (from Supabase Storage / document_library) and
// AI-generated schemes, so teachers can generate KICD-compliant lesson plans
// for any grade/subject/term without re-entering data.
model KICDContent {
  id                 String   @id @default(cuid())
  grade              String   // e.g. "Grade 5"
  subject            String   // e.g. "Creative Arts", "Mathematics"
  term               Int      // 1, 2 or 3
  week               Int      // Week number within the term
  lesson             Int      // Lesson number within the week
  strand             String   // e.g. "PERFORMANCE AND DISPLAY"
  subStrand          String   // e.g. "Performing a Kenyan Folk Dance"
  learningOutcomes   String[] // Specific Learning Outcomes (SLOs)
  learningExperiences String[] // Learner experiences / activities
  keyInquiryQuestions String[] // Key inquiry questions
  resources          String[] // Learning resources
  assessment         String?  // Assessment methods (optional)
  values             String[] @default([]) // Core values (KICD)
  competencies       String[] @default([]) // Core competencies (CBC)
  source             String   @default("generated") // "generated" | "imported" | "manual"
  sourceUrl          String?  // Original document / storage URL
  isVerified         Boolean  @default(false) // Reviewed as KICD-compliant
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([grade, subject, term])
  @@index([grade, subject, term, week])
  @@map("kicd_content")
}

model LessonPlan {
  id             String   @id @default(cuid())
  title          String
  subject        String
  grade          String
  content        String // JSON content
  teacherId      String
  schemeOfWorkId String?
  isShared       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relationships
  teacher      Teacher            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schemeOfWork SchemeOfWork?      @relation(fields: [schemeOfWorkId], references: [id])
  assignments  Assignment[]
  sharedWith   SharedLessonPlan[]
  resources    Resource[]
  notes        TeacherNote[]

  @@map("lesson_plans")
}

model SharedLessonPlan {
  id            String    @id @default(cuid())
  lessonPlanId  String
  studentId     String
  teacherId     String
  sharedAt      DateTime  @default(now())
  isActive      Boolean   @default(true)
  loginAttempts Int       @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relationships
  lessonPlan LessonPlan @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher    Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([lessonPlanId, studentId], name: "lessonPlanId_studentId")
  @@map("shared_lesson_plans")
}

model Assignment {
  id            String           @id @default(cuid())
  title         String
  description   String
  content       String // JSON content
  dueDate       DateTime
  status        AssignmentStatus @default(PENDING)
  teacherId     String
  lessonPlanId  String?
  // Timed exam fields
  isTimed       Boolean          @default(false)
  timeLimit     Int? // In minutes
  startTime     DateTime? // When the exam becomes available
  // AI grading fields
  rubricId      String? // Link to rubric for AI grading
  aiGradeable   Boolean          @default(false)
  answerKey     String? // JSON with correct answers for automatic grading
  // Metadata
  classId       String? // Which class this assignment is for
  subject       String?
  grade         String?
  schoolId      String?
  // Video assignment fields
  videoUrl      String? // URL of the uploaded or linked video
  videoProvider String? // "youtube", "vimeo", or "upload"
  videoDuration Int? // Video duration in seconds
  // Exam bank + structured exam data
  metadata      Json? // exam bank flags, term/type/savedAt
  questions     Json? // structured question array
  totalMarks    Int? // total possible marks
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Relationships
  teacher     Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  lessonPlan  LessonPlan?  @relation(fields: [lessonPlanId], references: [id])
  students    Student[]
  submissions Submission[]
  class       Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)

  // Courses
  courseAssignments CourseAssignment[]

  // Exam lockdown sessions
  examSessions ExamSession[]

  @@map("assignments")
}

model Submission {
  id                String           @id @default(cuid())
  content           String // JSON content
  attachments       String[] // Array of file URLs
  grade             Float?
  feedback          String?
  status            AssignmentStatus @default(PENDING)
  submittedAt       DateTime         @default(now())
  gradedAt          DateTime?
  studentId         String
  assignmentId      String
  // Timed exam metadata
  startedAt         DateTime? // When student started the exam
  timeSpent         Int? // Total time spent in seconds
  // AI grading metadata
  isAiGraded        Boolean          @default(false)
  aiGradingMetadata Json? // Detailed AI grading breakdown
  aiConfidence      Float? // Confidence score of AI grading (0-1)
  // Question level data
  questionScores    Json? // JSON with per-question scores and feedback
  // Revision
  needsRevision     Boolean          @default(false)
  revisionNotes     String?

  // Relationships
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@map("submissions")
}

model StudentProgress {
  id        String         @id @default(cuid())
  status    ProgressStatus @default(NOT_STARTED)
  score     Float?
  feedback  String?
  teacherId String
  studentId String

  // NEW: Autonomous Tutor Fields (nullable for migration)
  classId             String?
  subject             String    @default("General")
  topic               String    @default("General Progress")
  masteryScore        Int       @default(0) // 0-100
  lastPracticedAt     DateTime?
  commonMistakes      Json? // Array of common mistakes
  preferredDifficulty String    @default("medium") // "easy", "medium", "hard"
  engagementProfile   Json? // Likes quizzes, stories, attention span, etc.
  streak              Int       @default(0) // Consecutive days of practice
  consecutiveCorrect  Int       @default(0) // Streak of correct answers in current session
  xp                  Int       @default(0) // Experience points
