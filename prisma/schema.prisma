enum AIImageType {
  DIAGRAM
  POSTER
  ILLUSTRATION
  CHART
  INFOGRAPHIC
  GENERAL
}

enum AIImageSize {
  SMALL_512
  MEDIUM_1024
  LARGE_1536
  PORTRAIT_1024
}

// AI Generated Images Storage
model AIGeneratedImage {
  id          String      @id @default(cuid())
  filename    String      @unique // elimu_2025_03_02_student123_plant_cell.png
  originalUrl String // Original OpenAI URL (temporary)
  storedUrl   String // Permanent storage URL
  topic       String // e.g., "Plant Cell", "Solar System"
  prompt      String // Original prompt used
  type        AIImageType @default(GENERAL)
  size        AIImageSize @default(MEDIUM_1024)
  quality     String      @default("standard") // standard or hd

  // User and context
  userId    String // Who generated it
  studentId String? // If generated by/for a student
  teacherId String? // If generated by a teacher
  schoolId  String? // School context
  classId   String? // Class context if applicable

  // Metadata
  fileSize   Int? // File size in bytes
  dimensions String? // JSON: {"width": 1024, "height": 1024}
  metadata   String? // JSON: Additional OpenAI metadata

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  school  School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class?   @relation(fields: [classId], references: [id], onDelete: Cascade)

  // Usage tracking
  usageHistory AIImageUsage[]

  @@map("ai_generated_images")
}

// Track how AI images are used (in presentations, assignments, etc.)
model AIImageUsage {
  id        String   @id @default(cuid())
  imageId   String
  usageType String // "presentation", "assignment", "download", "view"
  context   String? // Additional context (presentation ID, assignment ID, etc.)
  userId    String // Who used it
  createdAt DateTime @default(now())

  // Relationships
  image AIGeneratedImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_image_usage")
}

// Cached AI-generated lessons so repeat requests for the same subject/topic/grade
// are served instantly instead of regenerating (saves cost and latency).
model LessonCache {
  id        String   @id @default(cuid())
  subject   String
  topic     String // Canonical (normalized) topic used as the cache key
  grade     String
  content   Json // Full ActiveLesson object incl. durable image URLs
  aliases   String[] @default([]) // Alternate phrasings that mapped to this row
  hits      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subject, topic, grade])
  @@map("lesson_cache")
}

model LessonPlanCache {
  id        String   @id @default(cuid())
  subject   String
  topic     String
  grade     String
  mode      String   @default("single") // single | term
  content   Json     // Full lesson plan JSON
  aliases   String[] @default([])
  hits      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subject, topic, grade, mode])
  @@map("lesson_plan_cache")
}

model LessonContentCache {
  id        String   @id @default(cuid())
  subject   String
  topic     String
  grade     String
  content   String   @db.Text // Markdown content
  aliases   String[] @default([])
  hits      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subject, topic, grade])
  @@map("lesson_content_cache")
}

